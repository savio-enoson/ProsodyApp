            tensor<bool, []> c_phone_keep_dims_0 = const()[name = tensor<string, []>("c_phone_keep_dims_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 64]> c_phone_cast_fp16 = reduce_sum(axes = c_phone_axes_0, keep_dims = c_phone_keep_dims_0, x = var_84_cast_fp16)[name = tensor<string, []>("c_phone_cast_fp16")];
            tensor<string, []> word_feats_to_fp16_dtype_0 = const()[name = tensor<string, []>("word_feats_to_fp16_dtype_0"), val = tensor<string, []>("fp16")];
            tensor<fp16, [16, 19]> word_proj_0_weight_to_fp16 = const()[name = tensor<string, []>("word_proj_0_weight_to_fp16"), val = tensor<fp16, [16, 19]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(84096)))];
            tensor<fp16, [16]> word_proj_0_bias_to_fp16 = const()[name = tensor<string, []>("word_proj_0_bias_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(84800)))];
            tensor<fp16, [1, 19]> word_feats_to_fp16 = cast(dtype = word_feats_to_fp16_dtype_0, x = word_feats)[name = tensor<string, []>("cast_4")];
            tensor<fp16, [1, 16]> linear_51_cast_fp16 = linear(bias = word_proj_0_bias_to_fp16, weight = word_proj_0_weight_to_fp16, x = word_feats_to_fp16)[name = tensor<string, []>("linear_51_cast_fp16")];
            tensor<string, []> w_ctx_mode_0 = const()[name = tensor<string, []>("w_ctx_mode_0"), val = tensor<string, []>("EXACT")];
            tensor<fp16, [1, 16]> w_ctx_cast_fp16 = gelu(mode = w_ctx_mode_0, x = linear_51_cast_fp16)[name = tensor<string, []>("w_ctx_cast_fp16")];
            tensor<int32, []> var_97 = const()[name = tensor<string, []>("op_97"), val = tensor<int32, []>(-1)];
            tensor<bool, []> input_11_interleave_0 = const()[name = tensor<string, []>("input_11_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 80]> input_11_cast_fp16 = concat(axis = var_97, interleave = input_11_interleave_0, values = (c_phone_cast_fp16, w_ctx_cast_fp16))[name = tensor<string, []>("input_11_cast_fp16")];
            tensor<fp16, [32, 80]> score_head_0_weight_to_fp16 = const()[name = tensor<string, []>("score_head_0_weight_to_fp16"), val = tensor<fp16, [32, 80]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(84928)))];
            tensor<fp16, [32]> score_head_0_bias_to_fp16 = const()[name = tensor<string, []>("score_head_0_bias_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(90112)))];
            tensor<fp16, [1, 32]> linear_52_cast_fp16 = linear(bias = score_head_0_bias_to_fp16, weight = score_head_0_weight_to_fp16, x = input_11_cast_fp16)[name = tensor<string, []>("linear_52_cast_fp16")];
            tensor<string, []> input_15_mode_0 = const()[name = tensor<string, []>("input_15_mode_0"), val = tensor<string, []>("EXACT")];
            tensor<fp16, [1, 32]> input_15_cast_fp16 = gelu(mode = input_15_mode_0, x = linear_52_cast_fp16)[name = tensor<string, []>("input_15_cast_fp16")];
            tensor<fp16, [1, 32]> score_head_2_weight_to_fp16 = const()[name = tensor<string, []>("score_head_2_weight_to_fp16"), val = tensor<fp16, [1, 32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(90240)))];
            tensor<fp16, [1]> score_head_2_bias_to_fp16 = const()[name = tensor<string, []>("score_head_2_bias_to_fp16"), val = tensor<fp16, [1]>([0x1.bd8p-4])];
            tensor<fp16, [1, 1]> linear_53_cast_fp16 = linear(bias = score_head_2_bias_to_fp16, weight = score_head_2_weight_to_fp16, x = input_15_cast_fp16)[name = tensor<string, []>("linear_53_cast_fp16")];
            tensor<fp16, [1, 1]> var_109_cast_fp16 = sigmoid(x = linear_53_cast_fp16)[name = tensor<string, []>("op_109_cast_fp16")];
            tensor<fp16, []> var_110_to_fp16 = const()[name = tensor<string, []>("op_110_to_fp16"), val = tensor<fp16, []>(0x1.4p+3)];
            tensor<fp16, [1, 1]> var_111_cast_fp16 = mul(x = var_109_cast_fp16, y = var_110_to_fp16)[name = tensor<string, []>("op_111_cast_fp16")];
            tensor<string, []> var_111_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("op_111_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp16, [16, 80]> error_head_0_weight_to_fp16 = const()[name = tensor<string, []>("error_head_0_weight_to_fp16"), val = tensor<fp16, [16, 80]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(90368)))];
            tensor<fp16, [16]> error_head_0_bias_to_fp16 = const()[name = tensor<string, []>("error_head_0_bias_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(92992)))];
            tensor<fp16, [1, 16]> linear_54_cast_fp16 = linear(bias = error_head_0_bias_to_fp16, weight = error_head_0_weight_to_fp16, x = input_11_cast_fp16)[name = tensor<string, []>("linear_54_cast_fp16")];
            tensor<string, []> input_mode_0 = const()[name = tensor<string, []>("input_mode_0"), val = tensor<string, []>("EXACT")];
            tensor<fp16, [1, 16]> input_cast_fp16 = gelu(mode = input_mode_0, x = linear_54_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [1, 16]> error_head_2_weight_to_fp16 = const()[name = tensor<string, []>("error_head_2_weight_to_fp16"), val = tensor<fp16, [1, 16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(93120)))];
            tensor<fp16, [1]> error_head_2_bias_to_fp16 = const()[name = tensor<string, []>("error_head_2_bias_to_fp16"), val = tensor<fp16, [1]>([0x1.37cp-3])];
            tensor<fp16, [1, 1]> linear_55_cast_fp16 = linear(bias = error_head_2_bias_to_fp16, weight = error_head_2_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_55_cast_fp16")];
            tensor<string, []> linear_55_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("linear_55_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [1, 1]> error_logit = cast(dtype = linear_55_cast_fp16_to_fp32_dtype_0, x = linear_55_cast_fp16)[name = tensor<string, []>("cast_2")];
            tensor<fp32, [1, 1]> word_score = cast(dtype = var_111_cast_fp16_to_fp32_dtype_0, x = var_111_cast_fp16)[name = tensor<string, []>("cast_3")];
        } -> (word_score, error_logit);
}